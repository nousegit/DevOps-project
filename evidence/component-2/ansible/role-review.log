$ nl -ba ansible/roles/todo_app/tasks/main.yml
     1	---
     2	- name: Install Java runtime
     3	  ansible.builtin.package:
     4	    name: openjdk-17-jre-headless
     5	    state: present
     6	
     7	- name: Create application account
     8	  ansible.builtin.user:
     9	    name: "{{ app_user }}"
    10	    system: true
    11	    shell: /usr/sbin/nologin
    12	
    13	- name: Create application directory
    14	  ansible.builtin.file:
    15	    path: /opt/todo
    16	    state: directory
    17	    owner: "{{ app_user }}"
    18	    group: "{{ app_user }}"
    19	    mode: '0755'
    20	
    21	- name: Copy application jar
    22	  ansible.builtin.copy:
    23	    src: "{{ app_jar_source }}"
    24	    dest: "{{ app_jar_destination }}"
    25	    owner: "{{ app_user }}"
    26	    group: "{{ app_user }}"
    27	    mode: '0644'
    28	  notify: Restart todo app
    29	
    30	- name: Install systemd service
    31	  ansible.builtin.template:
    32	    src: todo-app.service.j2
    33	    dest: /etc/systemd/system/todo-app.service
    34	    mode: '0644'
    35	  notify: Restart todo app
    36	
    37	- name: Ensure Todo app is enabled and running
    38	  ansible.builtin.systemd:
    39	    name: todo-app
    40	    enabled: true
    41	    state: started
    42	    daemon_reload: true
